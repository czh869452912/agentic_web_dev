# 复制为 .env 后修改；AI 工具的模型认证在各自界面配置。
GATEWAY_PORT=8443
CODE_SERVER_PASSWORD=YourSecurePassword123
SUDO_PASSWORD=YourSudoPassword123

# DSH 使用 code-server 子域名 forwarding，默认 {{port}}.localhost:<GATEWAY_PORT>。
# 远程访问需把对应域名解析到服务器，并在 HTTPS 证书中包含该域名。
# CODE_SERVER_PROXY_DOMAIN={{port}}.dev.example:8443

# LiteLLM 可选：先复制并编辑 configs/litellm_config.yaml.example
# Linux: ./scripts/manage.sh up --llm
# Windows: .\scripts\manage.ps1 up -Llm
INTERNAL_API_BASE=http://10.0.0.1:8000/v1
INTERNAL_API_KEY=your-internal-api-key
LITELLM_MASTER_KEY=sk-devenv

# 云端部署：用于生成包含该地址的 SSL 证书
# SERVER_DOMAIN=1.2.3.4
